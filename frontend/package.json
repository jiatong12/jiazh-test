{
  "name": "content-security-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build:dev": "rimraf dist && vue-tsc -b && vite build --mode development",
    "build:pro": "rimraf dist && vue-tsc -b && vite build --mode production",
    "build:compress": "rimraf dist && vue-tsc -b && vite build --mode production -- --compress",
    "build:archiver": "rimraf dist && vue-tsc -b && vite build --mode production -- --archiver",
    "build:visualizer": "rimraf dist && vue-tsc -b && vite build --mode production -- --visualizer",
    "type:check": "vue-tsc -b --noEmit",
    "preview": "vite preview",
    "lint:eslint": "eslint --fix",
    "lint:staged": "lint-staged",
    "lint:cache:eslint": "eslint --fix --cache --cache-location node_modules/.cache/eslint/ src/**/*.{ts,vue,js,tsx,jsx}",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node ./scripts/ai-assist-link.mjs",
    "up:major": "npx taze major -r -I",
    "up:minor": "npx taze minor -r -I",
    "up:patch": "npx taze patch -r -I",
    "update:deps": "npx taze -r -w",
    "clean": "pnpm -r exec -- pnpm dlx rimraf node_modules",
    "deepclean": "powershell -Command \"Get-ChildItem -Directory -Recurse -Filter 'node_modules' | Remove-Item -Recurse -Force\"",
    "reset": "pnpm deepclean && pnpm install",
    "prepare": "husky"
  },
  "scriptsComments": {
    "": "scriptsComments 是自定义属性，用来显示注释",
    "build:compress": "生产构建并额外生成 .gz/.br 预压缩文件",
    "build:archiver": "生产构建并在 dist 同级生成 dist.zip",
    "build:visualizer": "生产构建并输出依赖体积分析报告",
    "up": "检查版本更新，major:主要更新, minor:小版本更新, patch:补丁更新"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,vue,css,scss,less,postcss,html,json,jsonc,json5,yml,yaml}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tinymce/tinymce-vue": "^6",
    "@vueuse/core": "^14.1.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.13.2",
    "chroma-js": "^3.2.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.0",
    "grid-layout-plus": "^1.1.1",
    "jdenticon": "^3.3.0",
    "lodash-es": "^4.17.22",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "nprogress": "^0.2.0",
    "pagedjs": "^0.4.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.27.0",
    "qr-code-styling": "^1.9.2",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.6",
    "tinymce": "^6",
    "tinymce-i18n": "^23",
    "typeit": "^8.8.7",
    "vue": "^3.5.26",
    "vue-cropper": "^1.1.4",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.2.7",
    "vue-router": "^4.6.4",
    "vue-ueditor-wrap": "~3.0.8",
    "vue3-count-to": "^1.1.2",
    "xgplayer": "^3.0.23"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@faker-js/faker": "^10.1.0",
    "@iconify/json": "^2.2.444",
    "@iconify/utils": "^3.1.0",
    "@iconify/vue": "^5.0.0",
    "@types/archiver": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.8.1",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "pkg-types": "^2.3.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.54.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.97.1",
    "typescript": "~5.9.3",
    "unocss": "^66.5.12",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-fake-server": "^2.2.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.1"
  }
}
