VITE_GLOB_PRIMARY_COLOR = "#3182F3" # 默认主题色VITE_GLOB_APP_TITLE = "content-security-ui"
VITE_CACHE_VERSION = 1 # 缓存的版本，与本地不一致将清空 storage，一般不需要更改，不用 project.json 版本是为了避免每次更新都重置缓存
VITE_INCLUDE_GUIDES = true # 是否打包指南模块（示例和文档）
VITE_MOCK = false # 是否启用 Mock（注意：配置了 VITE_PROXY 时 Mock 不会生效，二者互斥以避免请求冲突）
