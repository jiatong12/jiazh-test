
# 注意，本地开发直接复制这个文件加上 .local 变成 .env.development.local，避免提交冲突VITE_GLOB_API_URL = /api

# 环境配置
VITE_DEMO_ACCOUNTS = '[
  {
    "label": "admin",
    "accountNo": "admin",
    "password": "admin"
  },
  {
    "label": "test",
    "accountNo": "test",
    "password": "test"
  },
  {
    "label": "hooray(无权限)",
    "accountNo": "hooray",
    "password": "hooray"
  }
]' # demo 账号，仅构建时读取
VITE_PUBLIC_PATH = / # 公共基础路径
VITE_DROP_CONSOLE = false # 打包时是否删除 console
VITE_INCLUDE_GUIDES = true # 是否打包指南模块（示例和文档），开发环境默认开启
VITE_MOCK = false # 是否启用 Mock（注意：配置了 VITE_PROXY 时 Mock 不会生效，二者互斥以避免请求冲突）
VITE_DEVTOOLS = true # 是否开启devtools（打包会忽略）
# VITE_GLOB_ZCAPTCHA_ENABLED = true # 开启新的ZCaptcha验证码
# VITE_GLOB_ZCAPTCHA_TYPE=Slider # 支持 Slider(滑块)、Click(文字点选)、GIF(动图)。

# 开发环境跨域代理，支持配置多个VITE_PROXY = [["/api","http://localhost:8080"]]
